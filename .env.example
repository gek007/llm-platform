# Copy to .env.local. Never commit real values.

# Clerk: development instance of the "LMS Platform" app.
# Fill with: clerk link && clerk env pull --file .env.local
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex: project llm-platform. Filled by: npx convex dev
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Set on the Convex deployment, not in this file:
#   npx convex env set CLERK_FRONTEND_API_URL https://<your-instance>.clerk.accounts.dev   (read by convex/auth.config.ts)
#   pbpaste | npx convex env set MUX_TOKEN_ID       (Mux Dashboard > Settings > Access Tokens)
#   pbpaste | npx convex env set MUX_TOKEN_SECRET

# Optional: Clerk Billing plan ID (cplan_...) of the "pro" plan. When empty, /pricing looks it up
# by slug through the Clerk backend SDK; set it to skip that call.
# NEXT_PUBLIC_CLERK_PRO_PLAN_ID=

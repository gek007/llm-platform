# Copy to .env.local. Never commit real values.

# Clerk: development instance of the "LMS Platform" app.
# Fill with: clerk link && clerk env pull --file .env.local
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex: project llm-platform. Filled by: npx convex dev
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Set on the Convex deployment, not in this file:
#   npx convex env set CLERK_FRONTEND_API_URL https://<your-instance>.clerk.accounts.dev   (read by convex/auth.config.ts)
#   pbpaste | npx convex env set MUX_TOKEN_ID       (Mux Dashboard > Settings > Access Tokens)
#   pbpaste | npx convex env set MUX_TOKEN_SECRET

# Optional: Clerk Billing plan ID (cplan_...) of the "pro" plan. When empty, /pricing looks it up
# by slug through the Clerk backend SDK; set it to skip that call.
# NEXT_PUBLIC_CLERK_PRO_PLAN_ID=

# Optional: Public Mux playback ID for the home page hero preview video (defaults in src/config/site.ts).
# NEXT_PUBLIC_HERO_MUX_PLAYBACK_ID=

# Anthropic API key for the Learnly tutor (agents/learnly, model claude-opus-5-5). Server only.
ANTHROPIC_API_KEY=

# Course engine (AI course generator). Optional: needed only where course generation runs. Kept
# commented so scripts/check-dev-tooling.sh doesn't require them in every .env.local or on Vercel.
# Bearer secret for the Convex /engine/* HTTP surface; the same value goes on the Convex deployment
# (openssl rand -hex 32 | npx convex env set COURSE_ENGINE_SECRET). Server only.
# COURSE_ENGINE_SECRET=<openssl rand -hex 32>
# HS256 key the Next.js routes use to sign JWTs for the course-builder agent channel. Server only.
# COURSE_BUILDER_CHANNEL_SECRET=<openssl rand -hex 32>
# "live" (default) dispatches to the course-builder agent; "fake" runs the canned engine instead.
# COURSE_ENGINE_MODE=live
# Base URL of the course-builder agent's /v1/* routes (default: npm run dev:course-builder).
# COURSE_BUILDER_URL=http://127.0.0.1:2001/eve
